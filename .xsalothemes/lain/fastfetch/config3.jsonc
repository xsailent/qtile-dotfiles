{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/xsailent/.config/fastfetch/logo.jpeg",
    "width": 15,
    "height": 15,
    "padding": { "right": 2 }
  },
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    { "type": "os", "key": " DISTRO", "keyColor": "#94455b" },
    { "type": "kernel", "key": "│ ├", "keyColor": "#94455b" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "#94455b" },
    {
      "type": "command",
      "key": "│ ├",
      "keyColor": "#94455b",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    { "type": "shell", "key": "│ └", "keyColor": "#94455b" },
    { "type": "wm", "key": " DE/WM", "keyColor": "#94455b" },
    { "type": "wmtheme", "key": "│ ├󰉼", "keyColor": "#94455b" },
    { "type": "icons", "key": "│ ├󰀻", "keyColor": "#94455b" },
    { "type": "cursor", "key": "│ ├", "keyColor": "#94455b" },
    { "type": "terminalfont", "key": "│ ├", "keyColor": "#94455b" },
    { "type": "terminal", "key": "│ └", "keyColor": "#94455b" },
    { "type": "host", "key": "󰌢 SYSTEM", "keyColor": "#94455b" },
    { "type": "cpu", "key": "│ ├󰻠", "keyColor": "#94455b" },
    { "type": "gpu", "key": "│ ├󰻑", "format": "{2}", "keyColor": "#94455b" },
    { "type": "display", "key": "│ ├󰍹", "keyColor": "#94455b", "compactType": "original-with-refresh-rate" },
    { "type": "memory", "key": "│ ├󰾆", "keyColor": "#94455b" },
    { "type": "swap", "key": "│ ├󰓡", "keyColor": "#94455b" },
    { "type": "uptime", "key": "│ ├󰅐", "keyColor": "#94455b" },
    { "type": "battery", "key": "│ └🎟", "keyColor": "#94455b" },
    { "type": "custom", "format": "\u001b[38;2;148;69;91m└──────────────────────────────────────────────────────┘" },
    { "type": "custom", "format": "\u001b[38;2;148;69;91m┌─────────────────────────MEDIA / SOUND─────────────────────────┐" },
    { "type": "sound", "key": "│ ├🕪", "format": "{2}", "keyColor": "#94455b" },
    { "type": "player", "key": "│ ├󰥠", "keyColor": "#94455b" },
    { "type": "media", "key": "│ └󰝚", "keyColor": "#94455b" },
    {
      "type": "custom",
      "format": "\u001b[38;2;148;69;91m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[38;2;148;69;91m"
    },
    "break"
  ]
}
